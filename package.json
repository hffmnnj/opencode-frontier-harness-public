{
  "name": "hffmnnj.frontier-harness",
  "version": "0.1.0",
  "description": "Research-grounded harness upgrades for OpenCode V2",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./loop-guard": "./dist/loop-guard.js",
    "./compaction": "./dist/compaction.js",
    "./insights": "./dist/insights.js",
    "./provider-compat": "./dist/provider-compat.js"
  },
  "files": [
    "dist",
    "index.ts",
    "loop-guard",
    "compaction",
    "insights",
    "provider-compat",
    "README.md",
    "assets/banner.png"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "build": "bun build src/index.ts src/provider-compat.ts src/loop-guard.ts src/compaction.ts src/insights.ts --target=bun --external=@opencode/plugin --external=effect --outdir=dist",
    "check": "bun run typecheck && bun run test && bun run build",
    "prepack": "bun run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hffmnnj/opencode-frontier-harness.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  }
}
